# Образец настроек домашнего сервера. Скопируйте в .env рядом с
# docker-compose.yml. Файл .env в git не попадает.

# IPv4-адрес ноутбука в домашней сети (например, 192.168.1.42).
# Docker публикует порт только на этом адресе.
LAN_BIND_IP=192.168.1.42

# Имя единственного пользователя. Регистрации нет.
AUTH_USERNAME=knitter

# Пароль. В базу записывается только хеш (argon2id), не эта строка.
# Повторный запуск контейнера уже созданного пользователя не перезаписывает:
# смена пароля — команда, а не правка этой строки задним числом.
#   docker compose exec app node server/dist/reset-password.js 'новая-длинная-фраза'
AUTH_PASSWORD=замените-на-длинную-фразу

# Пути и порт ниже в контейнере задаёт docker-compose.yml (данные в /data,
# сертификат из ./certs, наружу только 8443). Для запуска без Docker их можно
# переопределить здесь:
# DATA_DIR=data
# CERT_FILE=certs/cert.pem
# KEY_FILE=certs/key.pem
# STATIC_DIR=dist
# HOST=0.0.0.0
# PORT=8443
